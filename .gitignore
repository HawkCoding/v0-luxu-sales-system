package-lock.json
node_modules/
.next/
.env*.local
.DS_Store
.vercel

# Build artifacts
tsconfig.tsbuildinfo
next-env.d.ts
coverage/

# Temporary files
tmp-*.sql
tmp-db-sync/
tmp/

# Cursor IDE
.cursor/debug-*.log
.cursor/plans/

# QA / test run artefacts
qa-phase5-output*.log
qa/dev-server.log
*.log

# Local MCP configuration may contain access tokens
.mcp.json
.vscode/mcp.json
.claude/settings.local.json

# QA browser runs
qa/.auth/
qa/.run-state.json
qa/.playwright-libs/
qa/reports/
qa/screenshots/
qa/playwright-report/
qa/**/playwright-report/
test-results/

# Portal clone working files (DB dumps, secrets) - never commit
.portal-clone/

# QA screenshots (untracked 2026-07-12; binary artefacts don't belong in git)
qa-screenshots/
tests/qa/.auth/

# Handbook build output. The Markdown sources and docs/handbook/screenshots/ ARE
# committed — the generated PDFs and HTML are not.
docs/handbook/dist/
