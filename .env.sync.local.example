# Copy to .env.sync.local and fill in whichever option you prefer.
# .env.sync.local is ignored by git because .env*.local is ignored.

# Option A: full Postgres connection strings.
# SUPABASE_DEV_DB_URL=postgresql://postgres.<dev-project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres
# SUPABASE_PROD_DB_URL=postgresql://postgres.<prod-project-ref>:<password>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres

# Option B: project refs plus raw database passwords. The sync script will URL-encode the password
# and use Supabase's IPv4-compatible West EU pooler by default.
# SUPABASE_DEV_PROJECT_REF=isxpuhttwzyvjclrnhbg
# SUPABASE_DEV_DB_PASSWORD=
# SUPABASE_PROD_PROJECT_REF=qlwldfhjfbxliyjvoziu
# SUPABASE_PROD_DB_PASSWORD=

# Optional: only set these if Supabase shows a different pooler host for the project.
# SUPABASE_DEV_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com
# SUPABASE_PROD_POOLER_HOST=aws-1-eu-west-1.pooler.supabase.com
