{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "current",
        "linux",
        "win32"
      ],
      "cpu": [
        "current",
        "x64"
      ]
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "postinstall": "node scripts/install-hooks.mjs",
    "dev": "node scripts/start-next-dev.mjs",
    "local:start": "node scripts/dev-local.mjs",
    "build": "next build",
    "start": "next start",
    "app:version:bump": "node scripts/bump-app-version.mjs",
    "db:start": "npx supabase start",
    "db:stop": "npx supabase stop",
    "db:reset": "npx supabase db reset",
    "db:push": "npx supabase db push",
    "db:pull": "npx supabase db pull --schema public",
    "db:remote:compare": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-remote-databases.ps1 -Mode compare",
    "db:remote:push:dev": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-remote-databases.ps1 -Mode push -Target development",
    "db:remote:push:prod": "powershell -ExecutionPolicy Bypass -File ./scripts/sync-remote-databases.ps1 -Mode push -Target production -ConfirmProduction",
    "db:types": "npx supabase gen types typescript --local > lib/supabase/types.ts",
    "production:restore:bootstrap": "powershell -ExecutionPolicy Bypass -File ./scripts/restore-production-bootstrap.ps1",
    "production:restore:bootstrap:api": "node scripts/restore-production-bootstrap.mjs",
    "production:restore:users": "node scripts/restore-production-users.mjs",
    "lint": "eslint . --ext .js,.mjs,.cjs --no-error-on-unmatched-pattern --no-eslintrc --env es2022 --env node --parser-options=ecmaVersion:latest --parser-options=sourceType:module",
    "test": "vitest",
    "test:ci": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "types:db": "npx supabase gen types typescript --local > lib/supabase/types.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.98.0",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.6.0",
    "imapflow": "^1.3.2",
    "input-otp": "1.4.2",
    "lucide-react": "^0.564.0",
    "mailparser": "^3.9.8",
    "next": "16.1.6",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.4",
    "react-easy-crop": "^5.5.7",
    "react-hook-form": "^7.54.1",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.0",
    "resend": "^6.9.3",
    "sonner": "^1.7.1",
    "swr": "^2.3.3",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^8.57.1",
    "jsdom": "^29.1.1",
    "nodemailer": "^8.0.7",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.18"
  }
}
