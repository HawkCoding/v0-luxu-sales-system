# Copy this file to .env.local and fill in your values.
# .env.local is gitignored – never commit real keys.

# Supabase – public values (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key-from-supabase-dashboard>

# Supabase – service role key (SERVER ONLY – bypasses RLS)
# Get from: Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-from-supabase-dashboard>

# Supplier pricing sync token
# Generate with: openssl rand -hex 32
# Both variables must be set to the same value.
SUPPLIER_SYNC_TOKEN=<your-secret-token>
NEXT_PUBLIC_SUPPLIER_SYNC_TOKEN=<your-secret-token>
