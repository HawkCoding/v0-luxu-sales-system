# Copy this file to .env.local and fill in your values.
# .env.local is gitignored – never commit real keys.
# Use Supabase development branch credentials for local development and Vercel Preview.
# Keep Supabase production credentials only in Vercel Production environment variables.

# Development environment (local + Vercel Preview)
NEXT_PUBLIC_SUPABASE_URL=https://<dev-branch-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<dev-branch-anon-key-from-supabase-dashboard>

# Supabase service role key (SERVER ONLY - bypasses RLS)
# Get from: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=<dev-branch-service-role-key-from-supabase-dashboard>

# Supplier pricing sync token
# Generate with: openssl rand -hex 32
# Optional: only needed for server-to-server automation calls.
SUPPLIER_SYNC_TOKEN=<your-secret-token-optional>
NEXT_PUBLIC_SUPPLIER_SYNC_TOKEN=<same-token-as-supplier-sync-token>

# Developer auth: show dev name/password login on login page (default: false)
# NEXT_PUBLIC_DEV_AUTH=true

# Resend: for "password reset by admin" notification emails (optional)
# Get API key from https://resend.com
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=Luxus <notifications@yourdomain.com>

# Production environment (Vercel Production only)
# NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<prod-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<prod-service-role-key>
