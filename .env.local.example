# Copy this file to .env.local and fill in your values.
# .env.local is gitignored - never commit real keys.
# `pnpm local:start` injects local Supabase URL/keys at runtime, and both `pnpm local:start`
# and `pnpm dev` now share the same restart-safe Next.js launcher.
# You do not need to keep local Supabase connection values in this file for the one-command local flow.
# Keep hosted Supabase credentials here only when you explicitly want to run the app
# against a remote development branch instead of the local Supabase stack.

# Hosted development environment (remote branch + Vercel Preview)
# Leave these unset when using `pnpm local:start` for local Supabase development.
NEXT_PUBLIC_SUPABASE_URL=https://<dev-branch-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<dev-branch-anon-key-from-supabase-dashboard>

# Supabase service role key (SERVER ONLY - bypasses RLS)
# Get from: Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=<dev-branch-service-role-key-from-supabase-dashboard>

# Optional secrets used by both hosted dev and `pnpm local:start`

# Dev-only quick login. These are only exposed in local development and are ignored
# outside NODE_ENV=development. You can override them in the browser with
# localStorage keys devQuickLoginEmail and devQuickLoginPasswords.
# NEXT_PUBLIC_DEV_QUICK_LOGIN_EMAIL=carmen@luxustravel.co.za
# NEXT_PUBLIC_DEV_QUICK_LOGIN_PASSWORDS=password123

# Outbound email.
# When RESEND_API_KEY is set, the app sends via Resend. Without it, the app
# sends to local Mailpit over SMTP.
# Get API key from https://resend.com
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=Luxus <notifications@yourdomain.com>
# EMAIL_FROM_ADDRESS=Luxus <bookings@yourdomain.com>

# Local inbucket / Mailpit (when RESEND_API_KEY is not set)
# The Supabase local stack runs inbucket as the email catcher.
# MAILPIT_URL is the web UI only - it is NOT used to send mail.
# MAILPIT_URL=http://127.0.0.1:54324
#
# SMTP transport: the app delivers mail to inbucket's SMTP listener.
# The SMTP port is separate from the UI port and must be enabled in
# supabase/config.toml (smtp_port = 54325 is already uncommented).
# Set this in your .env.local (required for local mail delivery to work):
# MAILPIT_SMTP_PORT=54325

# Inbound email (IMAP) credential encryption.
# REQUIRED to add inbound mailboxes in Settings -> Inbound Email: the IMAP
# password is encrypted at rest with this key (AES-256-GCM, key = sha256 of the
# value, so any non-empty string works locally). Adding a mailbox returns a 500
# if this is unset. Use a strong random value in deployed environments.
EMAIL_CREDENTIAL_ENCRYPTION_KEY=local-dev-only-change-me

# Local restart notes:
# - run `pnpm local:start` for database + app
# - run `pnpm dev` when the local Supabase stack is already running and you only need the app
# - run `pnpm db:stop` only when you want to stop the local Supabase containers

# Gravity Forms webhook intake (app/api/webhooks/gravity-forms).
# Shared secret the web dev sends in the X-Webhook-Secret header on every
# request. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GRAVITY_FORMS_WEBHOOK_SECRET=

# Public enquiry intake (POST /api/enquiries).
# Unauthenticated callers (the public website form) must send this value in the
# X-Webhook-Secret header; logged-in staff sessions do not need it.
# Leave unset to make the route session-auth only.
# ENQUIRY_WEBHOOK_SECRET=

# Production environment (Vercel Production only)
# NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<prod-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<prod-service-role-key>
