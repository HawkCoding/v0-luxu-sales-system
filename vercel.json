{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "crons": [
    {
      "path": "/api/cron/email-sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/pipeline-auto-close",
      "schedule": "0 3 * * *"
    }
  ]
}
