// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateVoucherHTML > matches the voucher HTML snapshot with special requests 1`] = `
"<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Travel Voucher – LX-2026-001</title>
  <style>
    @page { size: A4; margin: 14mm; }
    body {
      font-family: Arial, sans-serif;
      font-size: 9pt;
      line-height: 1.4;
      color: #2B2B2B;
      margin: 0;
      padding: 34pt 40pt 40pt;
      position: relative;
    }
    .frame-outer, .frame-inner { position: absolute; pointer-events: none; }
    .frame-outer { inset: 14pt; border: 0.75pt solid #233f4e; }
    .frame-inner { inset: 17pt; border: 0.5pt solid #aab4ba; }

    /* Header variants */
    .header { margin-bottom: 10pt; }
    .header-logo-only { text-align: center; padding-bottom: 12pt; border-bottom: 0.5pt solid #919fa6; }
    .header-logo-center { max-height: 52px; object-fit: contain; margin-bottom: 6px; }
    .header-text-only { text-align: center; padding-bottom: 12pt; border-bottom: 0.5pt solid #919fa6; }

    .product-line {
      font-family: Arial, sans-serif;
      font-size: 8.5pt;
      font-weight: 700;
      color: #0B2A3A;
      letter-spacing: 2pt;
      text-transform: uppercase;
      margin-top: 8pt;
    }
    .header-subtitle {
      font-family: Arial, sans-serif;
      font-size: 9pt;
      color: #6B6B6B;
      font-style: italic;
      margin-top: 4pt;
    }

    /* Masthead row */
    .voucher-number-row {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      margin: 10pt 0 6pt;
    }
    h1 {
      font-family: Arial, sans-serif;
      font-size: 16pt;
      font-weight: 700;
      letter-spacing: 2pt;
      text-transform: uppercase;
      color: #0B2A3A;
      margin: 0;
    }
    .voucher-stub {
      border: 0.75pt solid #0B2A3A;
      border-left-style: dashed;
      padding: 3pt 12pt;
      text-align: center;
    }
    .voucher-stub-label {
      font-family: Arial, sans-serif;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: 1.5pt;
      text-transform: uppercase;
      color: #6B6B6B;
    }
    .voucher-stub-number {
      font-family: Arial, sans-serif;
      font-size: 11pt;
      font-weight: 700;
      color: #0B2A3A;
      margin-top: 2pt;
    }

    .guidance {
      font-family: Arial, sans-serif;
      font-size: 7.5pt;
      font-style: italic;
      line-height: 1.3;
      color: #6B6B6B;
      margin: 4pt 0 10pt;
      padding-right: 48pt;
    }

    .section { margin-bottom: 10pt; }
    .section-title {
      font-family: Arial, sans-serif;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: 1.2pt;
      text-transform: uppercase;
      color: #1a3a4a;
      border-bottom: 0.5pt solid #bac4c9;
      padding-bottom: 3pt;
      margin-bottom: 5pt;
    }
    .info-row {
      display: flex;
      gap: 12pt;
      padding: 1.5pt 0;
    }
    /* Legacy tables ruled every provider-box row with a dotted line; Guest Information bands
       alternating rows instead (info-row-shaded) — same distinction the legacy voucher made. */
    .info-row-dotted { border-bottom: 0.5pt dotted #bac4c9; padding-bottom: 2.5pt; }
    .info-row-shaded { background: #F4F4F4; margin: 0 -5pt; padding: 1.5pt 5pt; }
    .info-label {
      font-family: Arial, sans-serif;
      font-size: 7.5pt;
      font-weight: 700;
      letter-spacing: 0.4pt;
      text-transform: uppercase;
      text-align: right;
      color: #6B6B6B;
      padding-top: 1pt;
      width: 108pt;
      min-width: 108pt;
      flex-shrink: 0;
    }
    .info-value { color: #2B2B2B; font-size: 9pt; flex: 1; }

    .cell-group { display: flex; flex: 1; }
    .cell { box-sizing: border-box; padding-right: 16pt; }
    .cell-label {
      font-family: Arial, sans-serif;
      font-size: 6.5pt;
      font-weight: 700;
      letter-spacing: 1pt;
      text-transform: uppercase;
      color: #6B6B6B;
      margin-bottom: 2pt;
    }
    .cell-value { color: #2B2B2B; font-size: 9pt; }

    .provider-box {
      border: 0.75pt solid #bac4c9;
      padding: 7pt 9pt;
    }
    .provider-name {
      font-family: Arial, sans-serif;
      font-size: 11pt;
      font-weight: 700;
      color: #0B2A3A;
      margin-bottom: 1.5pt;
      text-align: center;
    }
    .provider-contact {
      font-family: Arial, sans-serif;
      font-size: 7pt;
      color: #6B6B6B;
      margin-bottom: 5pt;
      text-align: center;
    }
    .provider-description {
      font-family: Arial, sans-serif;
      font-size: 9.5pt;
      color: #6B6B6B;
      font-style: italic;
      margin-bottom: 12pt;
    }
    .provider-footnote {
      font-family: Arial, sans-serif;
      font-size: 7.5pt;
      color: #6B6B6B;
      font-style: italic;
      margin-top: 3pt;
    }

    .end-of-services {
      font-family: Arial, sans-serif;
      font-size: 8pt;
      letter-spacing: 1.5pt;
      text-transform: uppercase;
      color: #9A9A9A;
      text-align: center;
      margin: 2pt 0 8pt;
    }

    .footer-section { margin-top: 6pt; text-align: center; }
    .footer-contact {
      font-family: Arial, sans-serif;
      font-size: 7.5pt;
      color: #6B6B6B;
      margin-top: 4pt;
    }

    .page-number {
      font-family: Arial, sans-serif;
      text-align: center;
      font-size: 7.5pt;
      color: #9A9A9A;
      margin-top: 12pt;
    }
  </style>
</head>
<body>
  <div class="frame-outer"></div>
  <div class="frame-inner"></div>

  <div class="header header-text-only">
    <div class="product-line"></div>
    <div class="header-subtitle"></div>
  </div>

  <div class="voucher-number-row">
    <h1>TRAVEL VOUCHERS</h1>
    <div class="voucher-stub">
      <div class="voucher-stub-label">Reference no.</div>
      <div class="voucher-stub-number">LX-2026-001</div>
    </div>
  </div>

<div class="guidance">Please hand to your service provider. Pre-payment was made by Luxus Travel &amp; Tours for all services mentioned below. Guests must settle extras direct with the service providers.</div>


  <div class="section">
    <div class="section-title">Guest Information</div>

      <div class="info-row info-row-shaded">
        <div class="info-label">Guest Names</div>
        <div class="info-value">John and Jane Smith</div>
      </div>

      <div class="info-row">
        <div class="info-label">Number of Guests</div>
        <div class="info-value">2 (2 adults)</div>
      </div>

      <div class="info-row info-row-shaded">
        <div class="info-label">Consultant</div>
        <div class="info-value">Leonie</div>
      </div>

      <div class="info-row">
        <div class="info-label">Special Requests</div>
        <div class="info-value">Anniversary celebration</div>
      </div>
  </div>

  <div class="section">
    <div class="section-title">Service Provider</div>
    <div class="provider-box">
      <div class="provider-name">Rovos Rail</div>


      <div class="info-row info-row-dotted">
        <div class="info-label">Your Reference</div>
        <div class="info-value">LX-2026-001</div>
      </div>

      <div class="info-row info-row-dotted">
        <div class="info-label">Route</div>
        <div class="info-value">Pretoria to Cape Town</div>
      </div>

      <div class="info-row info-row-dotted">
        <div class="info-label">Departure Date</div>
        <div class="info-value">15 April 2026</div>
      </div>

      <div class="info-row info-row-dotted">
        <div class="info-label">Arrival Date</div>
        <div class="info-value">17 April 2026</div>
      </div>

      <div class="info-row info-row-dotted">
        <div class="info-label">Suite Type</div>
        <div class="info-value">Royal Double Suite</div>
      </div>

      <div class="info-row info-row-dotted">
        <div class="info-label">Number of Suites</div>
        <div class="info-value">1</div>
      </div>

      <div class="info-row info-row-dotted">
        <div class="info-label">Meal Basis</div>
        <div class="info-value">Full Board (All meals included)</div>
      </div>
    </div>
  </div>
  <div class="end-of-services">End of Services</div>

  <div class="section footer-section">

  </div>

  <div class="page-number">Page 1 of 1</div>
</body>
</html>"
`;
