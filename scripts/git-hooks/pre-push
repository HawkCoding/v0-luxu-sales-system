#!/bin/sh
# Blocks direct pushes to main. All changes must go through dev → main PR.
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "  BLOCKED: Direct push to main is not allowed."
    echo "  Push to dev instead, then open a PR from dev -> main."
    echo ""
    exit 1
  fi
done
exit 0
